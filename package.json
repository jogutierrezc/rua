{
  "name": "rua",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Rua — Portal de Inteligencia de Negocios y Gestión Académica",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc -b --noEmit",
    "db:types": "supabase gen types typescript --local > src/types/database.ts",
    "db:reset": "supabase db reset",
    "db:push": "supabase db push",
    "check:contraste": "tsx --tsconfig tsconfig.scripts.json scripts/verificar-contraste.ts",
    "gen:tokens": "tsx --tsconfig tsconfig.scripts.json scripts/generar-tokens-css.ts"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.1.1",
    "@supabase/supabase-js": "^2.48.1",
    "@tanstack/react-query": "^5.66.0",
    "clsx": "^2.1.1",
    "lucide-react": "^0.474.0",
    "motion": "^12.0.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.1.5",
    "read-excel-file": "^5.8.8",
    "sonner": "^1.7.4",
    "tailwind-merge": "^2.6.0",
    "write-excel-file": "^2.3.10",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.19.0",
    "@types/node": "^22.13.0",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.19.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.18",
    "globals": "^15.14.0",
    "postcss": "^8.5.1",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "~5.7.3",
    "typescript-eslint": "^8.22.0",
    "vite": "^6.0.11"
  },
  "engines": {
    "node": ">=20.19"
  }
}
